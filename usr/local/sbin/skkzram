#!/usr/bin/env bash
# skkzram  ——  zram swap 管理脚本
# 配置文件: /etc/skkzram.conf
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

CONF=/etc/skkzram.conf
MODULE=zram
DEV_PRE=/dev/zram

# 日志级别定义
LOG_LEVEL_ERROR=0
LOG_LEVEL_WARN=1
LOG_LEVEL_INFO=2
LOG_LEVEL_DEBUG=3

# ----------- 默认参数 -----------
export ALGO=lz4
export SIZE=3G
export PRIO=100
export DEVICES=1
export LOG_LEVEL=$LOG_LEVEL_INFO
export WRITEBACK_DEV=
export MEM_PERCENTAGE_LIMIT=
export IDLE_WRITEBACK_SECS=
export MEM_TRACKING=0
# --------------------------------

# 日志函数
log_error() {
    if [[ $LOG_LEVEL -ge $LOG_LEVEL_ERROR ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] skkzram: $*" >&2
    fi
}

log_warn() {
    if [[ $LOG_LEVEL -ge $LOG_LEVEL_WARN ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') [WARN] skkzram: $*"
    fi
}

log_info() {
    if [[ $LOG_LEVEL -ge $LOG_LEVEL_INFO ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] skkzram: $*"
    fi
}

log_debug() {
    if [[ $LOG_LEVEL -ge $LOG_LEVEL_DEBUG ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') [DEBUG] skkzram: $*"
    fi
}

# 读配置文件（如果存在）
if [[ -f $CONF ]]; then
    log_debug "Loading configuration from $CONF"
    . "$CONF"
else
    log_debug "Configuration file $CONF does not exist"
fi

# 检查并加载zram模块
check_and_load_zram() {
    # 确认模块存在
    if [[ ! -f /proc/config.gz ]] && [[ ! -f /boot/config-$(uname -r) ]]; then
        log_error "Cannot determine kernel config: neither /proc/config.gz nor /boot/config-$(uname -r) exists"
        return 1
    fi
    
    CONFIG_ZRAM_STATUS=""
    if [[ -f /proc/config.gz ]]; then
        CONFIG_ZRAM_STATUS=$(zgrep -E '^CONFIG_ZRAM=' /proc/config.gz | grep -o '=[ym]' || true)
    elif [[ -f /boot/config-$(uname -r) ]]; then
        CONFIG_ZRAM_STATUS=$(grep -E '^CONFIG_ZRAM=' /boot/config-$(uname -r) | grep -o '=[ym]' || true)
    fi
    
    case "$CONFIG_ZRAM_STATUS" in
        "=y")
            log_info "zram is built into the kernel"
            # 内建到内核中，无需加载模块
            ;;
        "=m")
            log_info "zram is available as a loadable module"
            # 作为模块提供，尝试加载
            if ! modprobe "$MODULE" num_devices="$DEVICES" 2>/dev/null; then
                log_error "failed to load zram module"
                return 1
            fi
            ;;
        *)
            log_error "zram is not enabled in the kernel (CONFIG_ZRAM != y or m)"
            return 1
            ;;
    esac
    
    # 检查zram设备是否存在
    if [[ ! -d /sys/block/zram0 ]]; then
        log_error "zram module is not loaded or not supported"
        return 1
    fi
    
    return 0
}

# 监控zram使用情况
monitor_zram() {
    log_info "Monitoring zram devices:"
    for i in $(seq 0 $((DEVICES - 1))); do
        if [[ -d /sys/block/zram"${i}" ]]; then
            disksize=$(cat /sys/block/zram"${i}"/disksize 2>/dev/null || echo "N/A")
            mem_used_total=$(cat /sys/block/zram"${i}"/mem_used_total 2>/dev/null || echo "N/A")
            comp_algorithm=$(cat /sys/block/zram"${i}"/comp_algorithm 2>/dev/null || echo "N/A")
            orig_data_size=$(cat /sys/block/zram"${i}"/orig_data_size 2>/dev/null || echo "N/A")
            compr_data_size=$(cat /sys/block/zram"${i}"/compr_data_size 2>/dev/null || echo "N/A")
            mem_limit=$(cat /sys/block/zram"${i}"/mem_limit 2>/dev/null || echo "N/A")
            zero_pages=$(cat /sys/block/zram"${i}"/zero_pages 2>/dev/null || echo "N/A")
            max_comp_streams=$(cat /sys/block/zram"${i}"/max_comp_streams 2>/dev/null || echo "N/A")
            
            log_info "zram$i: disksize=$disksize, mem_used=$mem_used_total, algo=$comp_algorithm"
            log_info "zram$i: original_size=$orig_data_size, compressed_size=$compr_data_size"
            log_info "zram$i: mem_limit=$mem_limit, zero_pages=$zero_pages, max_comp_streams=$max_comp_streams"
            
            # 显示额外参数（如果配置了的话）
            if [[ -f /sys/block/zram"${i}"/writeback_dev ]]; then
                wb_device=$(cat /sys/block/zram"${i}"/writeback_dev 2>/dev/null || echo "N/A")
                log_debug "zram$i: writeback_dev=$wb_device"
            fi
            
            if [[ -f /sys/block/zram"${i}"/idle_writeback_secs ]]; then
                idle_wb=$(cat /sys/block/zram"${i}"/idle_writeback_secs 2>/dev/null || echo "N/A")
                log_debug "zram$i: idle_writeback_secs=$idle_wb"
            fi
        else
            log_warn "zram$i device does not exist"
        fi
    done
}

# 应用高级参数设置
apply_advanced_settings() {
    local i=$1
    local has_errors=0
    
    # 设置写回设备（如果指定）
    if [[ -n "$WRITEBACK_DEV" ]]; then
        if [[ -f /sys/block/zram"${i}"/writeback_dev ]] && [[ -b "$WRITEBACK_DEV" ]]; then
            if ! echo "$WRITEBACK_DEV" > /sys/block/zram"${i}"/writeback_dev 2>/dev/null; then
                log_warn "Failed to set writeback device $WRITEBACK_DEV for zram$i"
                has_errors=1
            else
                log_debug "Set writeback device $WRITEBACK_DEV for zram$i"
            fi
        else
            log_warn "Writeback device $WRITEBACK_DEV not available for zram$i"
            has_errors=1
        fi
    fi
    
    # 设置空闲写回秒数（如果指定）
    if [[ -n "$IDLE_WRITEBACK_SECS" ]]; then
        if [[ -f /sys/block/zram"${i}"/idle_writeback_secs ]]; then
            if ! echo "$IDLE_WRITEBACK_SECS" > /sys/block/zram"${i}"/idle_writeback_secs 2>/dev/null; then
                log_warn "Failed to set idle_writeback_secs to $IDLE_WRITEBACK_SECS for zram$i"
                has_errors=1
            else
                log_debug "Set idle_writeback_secs to $IDLE_WRITEBACK_SECS for zram$i"
            fi
        else
            log_warn "idle_writeback_secs not supported for zram$i"
            has_errors=1
        fi
    fi
    
    # 如果有错误返回非零值
    return $has_errors
}

start() {
    log_info "Starting skkzram with algo=$ALGO size=$SIZE prio=$PRIO devices=$DEVICES"
    [[ -n "$WRITEBACK_DEV" ]] && log_info "Writeback device: $WRITEBACK_DEV"
    [[ -n "$IDLE_WRITEBACK_SECS" ]] && log_info "Idle writeback seconds: $IDLE_WRITEBACK_SECS"
    [[ -n "$MEM_PERCENTAGE_LIMIT" ]] && log_info "Memory percentage limit: $MEM_PERCENTAGE_LIMIT%"
    
    for i in $(seq 0 $((DEVICES - 1))); do
        DEV=${DEV_PRE}${i}
        
        # 检查设备是否存在
        if [[ ! -b "$DEV" ]]; then
            log_error "Device $DEV does not exist"
            exit 1
        fi
        
        # 设置压缩算法
        if ! echo "$ALGO" > /sys/block/zram"${i}"/comp_algorithm 2>/dev/null; then
            log_warn "Failed to set compression algorithm $ALGO for $DEV"
        else
            log_debug "Set compression algorithm $ALGO for $DEV"
        fi
        
        # 如果设置了内存限制百分比，则计算实际大小
        if [[ -n "$MEM_PERCENTAGE_LIMIT" ]]; then
            # 获取总内存大小（以kB为单位）
            local total_mem_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
            # 计算限制大小（以字节为单位）
            local limit_bytes=$((total_mem_kb * 1024 * MEM_PERCENTAGE_LIMIT / 100))
            # 转换为合适的单位
            if [[ $limit_bytes -gt $((1024*1024*1024)) ]]; then
                # GB
                local limit_display="$((limit_bytes / (1024*1024*1024)))G"
            elif [[ $limit_bytes -gt $((1024*1024)) ]]; then
                # MB
                local limit_display="$((limit_bytes / (1024*1024)))M"
            else
                # KB
                local limit_display="$((limit_bytes / 1024))K"
            fi
            
            # 设置磁盘大小
            if ! echo "$limit_display" > /sys/block/zram"${i}"/disksize 2>/dev/null; then
                log_error "Failed to set disksize $limit_display for $DEV"
                exit 1
            else
                log_debug "Set disksize $limit_display for $DEV (based on ${MEM_PERCENTAGE_LIMIT}% of total memory)"
            fi
        else
            # 使用配置的固定大小
            if ! echo "$SIZE" > /sys/block/zram"${i}"/disksize 2>/dev/null; then
                log_error "Failed to set disksize $SIZE for $DEV"
                exit 1
            else
                log_debug "Set disksize $SIZE for $DEV"
            fi
        fi
        
        # 应用高级设置
        apply_advanced_settings "$i"
        
        # 创建交换分区
        if ! mkswap "$DEV" >/dev/null 2>&1; then
            log_error "Failed to create swap on $DEV"
            exit 1
        else
            log_debug "Created swap on $DEV"
        fi
        
        # 启用交换分区
        if ! swapon -p "$PRIO" "$DEV" >/dev/null 2>&1; then
            log_error "Failed to activate swap on $DEV"
            exit 1
        else
            log_debug "Activated swap on $DEV with priority $PRIO"
        fi
    done
    
    log_info "zram swap successfully activated"
    monitor_zram
}

stop() {
    log_info "Stopping skkzram"
    
    for i in $(seq 0 $((DEVICES - 1))); do
        DEV=${DEV_PRE}${i}
        
        # 检查设备是否正在使用作交换分区
        if swapon --show | grep -q "$DEV"; then
            if ! swapoff "$DEV" >/dev/null 2>&1; then
                log_warn "Failed to deactivate swap on $DEV"
            else
                log_debug "Deactivated swap on $DEV"
            fi
        else
            log_debug "$DEV is not active as swap"
        fi
        
        # 重置zram设备
        if [[ -f /sys/block/zram"${i}"/reset ]]; then
            if ! echo 1 > /sys/block/zram"${i}"/reset 2>/dev/null; then
                log_warn "Failed to reset $DEV"
            else
                log_debug "Reset $DEV"
            fi
        fi
    done
    
    # 尝试卸载模块（仅当它是作为模块加载时）
    CONFIG_ZRAM_STATUS=""
    if [[ -f /proc/config.gz ]]; then
        CONFIG_ZRAM_STATUS=$(zgrep -E '^CONFIG_ZRAM=' /proc/config.gz | grep -o '=[ym]' || true)
    elif [[ -f /boot/config-$(uname -r) ]]; then
        CONFIG_ZRAM_STATUS=$(grep -E '^CONFIG_ZRAM=' /boot/config-$(uname -r) | grep -o '=[ym]' || true)
    fi
    
    if [[ $CONFIG_ZRAM_STATUS == "=m" ]]; then
        if rmmod "$MODULE" 2>/dev/null; then
            log_debug "Removed zram module"
        else
            log_debug "Failed to remove zram module (may still be in use)"
        fi
    else
        log_debug "zram is built-in to kernel, no module to remove"
    fi
    
    log_info "zram swap successfully deactivated"
}

# 根据第一个参数确定操作
case "${1:-}" in
    start)  
        if ! check_and_load_zram; then
            log_error "Failed to check or load zram, exiting"
            exit 1
        fi
        start 
        ;;
    stop)   
        stop   
        ;;
    restart) 
        stop
        if ! check_and_load_zram; then
            log_error "Failed to check or load zram, exiting"
            exit 1
        fi
        start 
        ;;
    monitor)
        if ! check_and_load_zram; then
            log_error "Failed to check or load zram"
            exit 1
        fi
        monitor_zram
        ;;
    *) 
        echo "Usage: $0 {start|stop|restart|monitor}"
        echo "  start   - Start zram swap devices"
        echo "  stop    - Stop zram swap devices"
        echo "  restart - Restart zram swap devices"
        echo "  monitor - Display zram statistics"
        exit 1 
        ;;
esac